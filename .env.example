LLM_API_KEY="your_api_key"
LLM_MODEL_ID="deepseek-v4-flash"
LLM_BASE_URL="https://api.deepseek.com"
AMAP_API_KEY="your_amap_web_service_key"
AMAP_MCP_COMMAND="uvx amap-mcp-server"
AMAP_MCP_TIMEOUT_SECONDS="30"
API_HOST="127.0.0.1"
API_PORT="8000"
API_CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
TRAVEL_API_DB_PATH="var/travel_plan.db"
TRAVEL_API_MAX_WORKERS="2"
TRAVEL_API_TASK_TIMEOUT_SECONDS="600"
TRAVEL_API_SSE_POLL_SECONDS="0.5"
TRAVEL_API_SSE_HEARTBEAT_SECONDS="15"
AUTH_COOKIE_NAME="travel_session"
AUTH_SESSION_DAYS="7"
# 生产 HTTPS 环境应设为 true；本地 HTTP 开发保持 false
AUTH_COOKIE_SECURE="false"

# LangSmith 可观测性（创建 API Key 后改为 true）
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="travel-planning-harness"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# API Key 关联多个 Workspace 时必须填写
LANGSMITH_WORKSPACE_ID=""

# 第二阶段 LLM Judge（留空时逐项复用上方 LLM_* 配置）
# 正式模型对比建议使用与被测模型不同的 Judge 模型，降低自评偏差。
EVAL_JUDGE_API_KEY=""
EVAL_JUDGE_MODEL_ID=""
EVAL_JUDGE_BASE_URL=""
EVAL_JUDGE_TIMEOUT_SECONDS="60"
EVAL_JUDGE_MAX_RETRIES="2"
EVAL_JUDGE_REPETITIONS="1"
